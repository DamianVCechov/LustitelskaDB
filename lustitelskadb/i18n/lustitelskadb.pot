#: lustitelskadb/templates/help/warmer_newresult.xhtml:11
msgid "How to properly upload screenshots from the game"
msgstr ""

#: lustitelskadb/templates/help/warmer_newresult.xhtml:12
msgid ""
"To make your results clear and easy to compare with other players, please pay"
" attention to the following guidelines when taking screenshots:"
msgstr ""

#: lustitelskadb/templates/help/warmer_newresult.xhtml:15
msgid "Words revealed:"
msgstr ""

#: lustitelskadb/templates/help/warmer_newresult.xhtml:15
msgid "Upload only screenshots that clearly show the revealed words from the game."
msgstr ""

#: lustitelskadb/templates/help/warmer_newresult.xhtml:16
msgid "Maximum number of words:"
msgstr ""

#: lustitelskadb/templates/help/warmer_newresult.xhtml:16
msgid ""
"Add at least one screenshot where you have revealed as many words as possible"
" (ideally the entire completed game)."
msgstr ""

#: lustitelskadb/templates/help/warmer_newresult.xhtml:17
msgid "Visible number of guesses:"
msgstr ""

#: lustitelskadb/templates/help/warmer_newresult.xhtml:17
msgid ""
"Make sure that the number of attempts/guesses indicator is visible on the "
"screenshot."
msgstr ""

#: lustitelskadb/templates/help/warmer_newresult.xhtml:18
msgid "Up to 10 screenshots:"
msgstr ""

#: lustitelskadb/templates/help/warmer_newresult.xhtml:18
msgid ""
"You can attach up to 10 screenshots to one played round (e.g. the progress of"
" the game bit by bit)."
msgstr ""

#: lustitelskadb/templates/help/warmer_newresult.xhtml:21
msgid "Why save screenshots"
msgstr ""

#: lustitelskadb/templates/help/warmer_newresult.xhtml:22
msgid ""
"All uploaded screenshots will remain securely stored in your profile. You can"
" return to them at any time, view the history, check the actions of others "
"and compare which strategy each person chose when guessing."
msgstr ""

